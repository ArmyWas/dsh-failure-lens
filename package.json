{
  "name": "dsh-failure-lens",
  "version": "0.3.0",
  "description": "Deterministic DeepSeek Harness Web client plugin that explains the Windows-sandbox `spawn EPERM` failure as a distinct Conversation Node.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./classifier": {
      "types": "./lib/types/classifier.d.ts",
      "default": "./lib/classifier.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/classifier.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/BOUNDARY_EVIDENCE.md",
    "docs/CAPABILITIES.md",
    "docs/RELEASE_CRITERIA.md",
    "docs/RELEASE_NOTES_v0.2.0.md",
    "docs/RELEASE_NOTES_v0.2.1.md",
    "docs/RELEASE_NOTES_v0.2.2.md",
    "docs/RELEASE_NOTES_v0.3.0.md",
    "docs/failure-lens-harness-v0.2.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['lib']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "check:scripts": "node --check scripts/build-client.mjs && node --check scripts/build-lib.mjs && node --check scripts/build-test.mjs && node --check scripts/init-upstream-profile.mjs && node --check scripts/check-package-contract.mjs && node --check scripts/check-removed-runtime-tag.mjs && node --check scripts/smoke-web-profile.mjs",
    "check:contract": "node scripts/check-package-contract.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib && npm run build:client",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/build-lib.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:test": "node scripts/build-test.mjs",
    "test": "node scripts/build-test.mjs && node --test test-dist/all.test.mjs",
    "check": "npm run check:scripts && npm run check:contract && npm run typecheck && npm test && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client",
    "sandbox",
    "windows",
    "eperm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmyWas/dsh-failure-lens.git"
  },
  "bugs": {
    "url": "https://github.com/ArmyWas/dsh-failure-lens/issues"
  },
  "homepage": "https://github.com/ArmyWas/dsh-failure-lens#readme",
  "author": "ArmyWas",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.29.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
